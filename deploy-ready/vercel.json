{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/self-order/",
      "destination": "/order/",
      "permanent": false
    },
    {
      "source": "/self-order/:table([A-Za-z0-9-]+)/",
      "destination": "/order/:table/",
      "permanent": false
    },
    {
      "source": "/order/:table([A-Za-z]?-?[0-9]{1,2})/",
      "destination": "/order/?table=:table",
      "permanent": false
    },
    {
      "source": "/order/meja-:table([A-Za-z]?-?[0-9]{1,2})/",
      "destination": "/order/?table=:table",
      "permanent": false
    },
    {
      "source": "/order/m-:table([A-Za-z]?-?[0-9]{1,2})/",
      "destination": "/order/?table=:table",
      "permanent": false
    },
    {
      "source": "/order/meja:table([A-Za-z]?-?[0-9]{1,2})/",
      "destination": "/order/?table=:table",
      "permanent": false
    },
    {
      "source": "/order/m:table([A-Za-z]?-?[0-9]{1,2})/",
      "destination": "/order/?table=:table",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/pesan/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/order/status/:path*",
      "destination": "/order/"
    },
    {
      "source": "/duitku/callback",
      "destination": "https://veifszvxdfkzpcxhbqlu.supabase.co/functions/v1/duitku-payment-webhook"
    },
    {
      "source": "/pos",
      "destination": "/pos/"
    },
    {
      "source": "/self-order",
      "destination": "/self-order/"
    },
    {
      "source": "/self-order/:path*",
      "destination": "/self-order/"
    },
    {
      "source": "/delivery",
      "destination": "/delivery/"
    },
    {
      "source": "/delivery/:path*",
      "destination": "/delivery/"
    },
    {
      "source": "/driver",
      "destination": "/driver/"
    },
    {
      "source": "/driver/:path*",
      "destination": "/driver/"
    }
  ]
}
